<mjml>
	<mj-head>
		<mj-attributes>
			<mj-all font-family='Segoe UI, Arial, sans-serif' />
			<mj-text color='#0f172a' line-height='1.65' font-size='15px' />
			<mj-button background-color='#0f172a' color='#ffffff' font-size='15px' font-weight='700' border-radius='10px' />
		</mj-attributes>
	</mj-head>
	<mj-body background-color='#f1f5f9'>
		<mj-wrapper padding='22px 12px'>
			<mj-section background-color='#111827' border-radius='20px 20px 0 0' padding='30px 28px 16px'>
				<mj-column>
					<mj-text font-size='12px' letter-spacing='1px' color='#93c5fd' text-transform='uppercase' font-weight='700' padding='0 0 10px 0'>
						{{t 'mail.reset_subtitle'}}
					</mj-text>
					<mj-text font-size='26px' color='#f8fafc' font-weight='700' line-height='1.25' padding='0'>
						{{t 'mail.reset_title'}}
					</mj-text>
					<mj-text color='#cbd5e1' padding='14px 0 0 0'>
						{{t 'mail.reset_message' name=name expiresInMinutes=expiresInMinutes}}
					</mj-text>
				</mj-column>
			</mj-section>

			<mj-section background-color='#ffffff' border-radius='0 0 20px 20px' padding='0 28px 28px'>
				<mj-column>
					<mj-button href='{{resetLink}}' align='left' padding='24px 0 8px 0'>
						{{t 'mail.reset_button'}}
					</mj-button>

					<mj-text font-size='12px' color='#64748b' padding='0 0 18px 0'>
						{{t 'mail.reset_link_fallback'}}
					</mj-text>

					<mj-text font-size='13px' color='#0f172a' padding='0 0 20px 0'>
						<a href='{{resetLink}}' style='color:#2563eb; word-break:break-all;'>{{resetLink}}</a>
					</mj-text>

					<mj-text font-size='13px' color='#334155' font-weight='700' padding='0 0 10px 0'>
						{{t 'mail.reset_device_title'}}
					</mj-text>

					<mj-table>
						<tr>
							<td style='padding:7px 0; color:#64748b; font-size:13px;'>{{t 'mail.reset_device_name_label'}}</td>
							<td style='padding:7px 0; color:#0f172a; font-size:13px; font-weight:600; text-align:right;'>{{deviceName}}</td>
						</tr>
						<tr>
							<td style='padding:7px 0; color:#64748b; font-size:13px;'>{{t 'mail.reset_browser_label'}}</td>
							<td style='padding:7px 0; color:#0f172a; font-size:13px; font-weight:600; text-align:right;'>{{browser}}</td>
						</tr>
						<tr>
							<td style='padding:7px 0; color:#64748b; font-size:13px;'>{{t 'mail.reset_os_label'}}</td>
							<td style='padding:7px 0; color:#0f172a; font-size:13px; font-weight:600; text-align:right;'>{{os}}</td>
						</tr>
						<tr>
							<td style='padding:7px 0; color:#64748b; font-size:13px;'>{{t 'mail.reset_device_type_label'}}</td>
							<td style='padding:7px 0; color:#0f172a; font-size:13px; font-weight:600; text-align:right;'>{{deviceType}}</td>
						</tr>
						<tr>
							<td style='padding:7px 0; color:#64748b; font-size:13px;'>{{t 'mail.reset_ip_label'}}</td>
							<td style='padding:7px 0; color:#0f172a; font-size:13px; font-weight:600; text-align:right;'>{{ipAddress}}</td>
						</tr>
						<tr>
							<td style='padding:7px 0; color:#64748b; font-size:13px;'>{{t 'mail.reset_time_label'}}</td>
							<td style='padding:7px 0; color:#0f172a; font-size:13px; font-weight:600; text-align:right;'>{{requestedAtUtc}}</td>
						</tr>
					</mj-table>

					<mj-divider border-color='#e2e8f0' padding='20px 0 14px 0' />

					<mj-text font-size='12px' color='#64748b' padding='0'>
						{{t 'mail.reset_footer'}}
					</mj-text>
				</mj-column>
			</mj-section>
		</mj-wrapper>
	</mj-body>
</mjml>
