<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family='Segoe UI, Arial, sans-serif' />
      <mj-text color='#0f172a' line-height='1.65' font-size='15px' />
    </mj-attributes>
  </mj-head>
  <mj-body background-color='#f1f5f9'>
    <mj-wrapper padding='22px 12px'>
      <mj-section background-color='#0f172a' border-radius='20px 20px 0 0' padding='30px 28px 16px'>
        <mj-column>
          <mj-text font-size='12px' letter-spacing='1px' color='#86efac' text-transform='uppercase' font-weight='700' padding='0 0 10px 0'>
            {{t 'mail.password_updated_subtitle'}}
          </mj-text>
          <mj-text font-size='26px' color='#f8fafc' font-weight='700' line-height='1.25' padding='0'>
            {{t 'mail.password_updated_title'}}
          </mj-text>
          <mj-text color='#cbd5e1' padding='14px 0 0 0'>
            {{t 'mail.password_updated_message' name=name}}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color='#ffffff' border-radius='0 0 20px 20px' padding='0 28px 28px'>
        <mj-column>
          <mj-text font-size='13px' color='#334155' font-weight='700' padding='24px 0 10px 0'>
            {{t 'mail.password_updated_device_title'}}
          </mj-text>

          <mj-table>
            <tr>
              <td style='padding:7px 0; color:#64748b; font-size:13px;'>{{t 'mail.password_updated_device_name_label'}}</td>
              <td style='padding:7px 0; color:#0f172a; font-size:13px; font-weight:600; text-align:right;'>{{deviceName}}</td>
            </tr>
            <tr>
              <td style='padding:7px 0; color:#64748b; font-size:13px;'>{{t 'mail.password_updated_browser_label'}}</td>
              <td style='padding:7px 0; color:#0f172a; font-size:13px; font-weight:600; text-align:right;'>{{browser}}</td>
            </tr>
            <tr>
              <td style='padding:7px 0; color:#64748b; font-size:13px;'>{{t 'mail.password_updated_os_label'}}</td>
              <td style='padding:7px 0; color:#0f172a; font-size:13px; font-weight:600; text-align:right;'>{{os}}</td>
            </tr>
            <tr>
              <td style='padding:7px 0; color:#64748b; font-size:13px;'>{{t 'mail.password_updated_device_type_label'}}</td>
              <td style='padding:7px 0; color:#0f172a; font-size:13px; font-weight:600; text-align:right;'>{{deviceType}}</td>
            </tr>
            <tr>
              <td style='padding:7px 0; color:#64748b; font-size:13px;'>{{t 'mail.password_updated_ip_label'}}</td>
              <td style='padding:7px 0; color:#0f172a; font-size:13px; font-weight:600; text-align:right;'>{{ipAddress}}</td>
            </tr>
            <tr>
              <td style='padding:7px 0; color:#64748b; font-size:13px;'>{{t 'mail.password_updated_time_label'}}</td>
              <td style='padding:7px 0; color:#0f172a; font-size:13px; font-weight:600; text-align:right;'>{{requestedAtUtc}}</td>
            </tr>
          </mj-table>

          <mj-divider border-color='#e2e8f0' padding='20px 0 14px 0' />

          <mj-text font-size='12px' color='#64748b' padding='0'>
            {{t 'mail.password_updated_footer'}}
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
