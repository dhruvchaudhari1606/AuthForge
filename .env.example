# ==============================================================================
# AuthForge Environment Configuration
# ==============================================================================

# APP
APP_PORT=3000
APP_ENV=development
TRUST_PROXY=loopback

# CORS
CORS_ORIGIN=http://localhost:3001

# DATABASE (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=authforge

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=authforge:

# JWT
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production
JWT_EXPIRES_IN=15m
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# COOKIES
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_ACCESS_NAME=access_token
COOKIE_REFRESH_NAME=refresh_token

# SWAGGER & DOCUMENTATION
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# SENTRY (Monitoring & Error Reporting)
SENTRY_DSN=

# SECURITY
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# MAIL (Provider can be 'nodemailer' or 'sendgrid')
MAIL_PROVIDER=nodemailer

# NODEMAILER (SMTP)
NODEMAILER_SMTP_HOST=smtp.ethereal.email
NODEMAILER_SMTP_PORT=587
NODEMAILER_SMTP_USER=
NODEMAILER_SMTP_PASS=
NODEMAILER_MAIL_FROM=noreply@authforge.local

# SENDGRID
SENDGRID_API_KEY=
SENDGRID_MAIL_FROM=noreply@authforge.local

# SEED CREDENTIALS (for npm run seed:run)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-running